# Shell functions

# Show tip when checking Node.js version via node --version or -v
if command -v node >/dev/null 2>&1; then
node() {
    if [ $# -eq 1 ] && { [ "$1" = "--version" ] || [ "$1" = "-v" ]; }; then
        command node --version
        echo "fnm use <version> to change version"
    else
        command node "$@"
    fi
}
fi

# MJ commands store (per-type lists under ~/.config/mj-commands)
_mj_cmd_dir="${XDG_CONFIG_HOME:-$HOME/.config}/mj-commands"
_mj_ctx_file="$_mj_cmd_dir/.context"

_mj_get_context() {
  if [ -f "$_mj_ctx_file" ]; then
    cat "$_mj_ctx_file" 2>/dev/null | tr -d '\n' || echo ""
  else
    echo ""
  fi
}

_mj_set_context() {
  local type="$1"
  echo "$type" > "$_mj_ctx_file" 2>/dev/null
}

_mj_tui_help() {
  cat <<'EOF'
  ctx,  c     - switch context
  list, ls, l - list commands
  run,  r     - pick & execute a command
  add,  a     - save last command as alias
  rm          - remove a command
  desc, d     - describe a command
  help, ?, h  - show this help
  quit, q     - exit (also Ctrl-D)
EOF
}

_mj_tui_loop() {
  local _mj_tui_exit=0
  trap '_mj_tui_exit=1' INT

  _mj_tui_help

  while true; do
    # Check if Ctrl-C was pressed at the prompt
    if [ "$_mj_tui_exit" -eq 1 ]; then
      echo ""
      echo "bye"
      break
    fi

    local ctx
    ctx="$(_mj_get_context)"
    local prompt
    if [ -n "$ctx" ]; then
      prompt="mj> [$ctx] "
    else
      prompt="mj> "
    fi

    local input
    if ! read -r "input?${prompt}"; then
      # Ctrl-D
      echo ""
      echo "bye"
      break
    fi

    # Reset Ctrl-C flag after read succeeds
    _mj_tui_exit=0

    # Skip empty input
    [ -z "$input" ] && continue

    # Parse command and args
    local loop_cmd loop_args
    loop_cmd="${input%% *}"
    if [ "$loop_cmd" = "$input" ]; then
      loop_args=""
    else
      loop_args="${input#* }"
    fi

    case "$loop_cmd" in
      ctx|c)
        if [ -n "$loop_args" ]; then
          mj ctx $loop_args
        else
          mj ctx
        fi
        ;;
      list|ls|l)
        if [ -n "$loop_args" ]; then
          mj list $loop_args
        else
          ctx="$(_mj_get_context)"
          if [ -n "$ctx" ]; then
            mj list "$ctx"
          else
            mj list
          fi
        fi
        ;;
      run|r|use)
        if [ -n "$loop_args" ]; then
          mj use $loop_args
        else
          mj use
        fi
        ;;
      add|a)
        if [ -n "$loop_args" ]; then
          mj add $loop_args
        else
          mj add
        fi
        ;;
      rm|remove)
        ctx="$(_mj_get_context)"
        if [ -n "$loop_args" ]; then
          # If only alias given and context is set, prepend context
          local rm_words=($=loop_args)
          if [ ${#rm_words[@]} -eq 1 ] && [ -n "$ctx" ]; then
            mj remove "$ctx" "$loop_args"
          else
            mj remove $loop_args
          fi
        else
          echo "usage: rm <alias>" >&2
        fi
        ;;
      desc|d|describe)
        ctx="$(_mj_get_context)"
        if [ -n "$loop_args" ]; then
          local desc_words=($=loop_args)
          if [ ${#desc_words[@]} -eq 1 ] && [ -n "$ctx" ]; then
            mj describe "$ctx" "$loop_args"
          else
            mj describe $loop_args
          fi
        else
          echo "usage: desc <alias>" >&2
        fi
        ;;
      help|\?|h)
        _mj_tui_help
        ;;
      quit|q|exit)
        echo "bye"
        break
        ;;
      *)
        # Treat as alias shorthand in current context
        ctx="$(_mj_get_context)"
        if [ -n "$ctx" ]; then
          mj use "$ctx" $input
        else
          echo "unknown command: $loop_cmd (set a context first or type 'help')" >&2
        fi
        ;;
    esac
  done

  trap - INT
}

mj() {
  local cmd="${1:-}"
  shift || true

  if [ "$cmd" = "--help" ] || [ "$cmd" = "-h" ] || [ "$cmd" = "help" ]; then
    cat <<'HELP'
mj - personal command manager

COMMANDS
  mj ctx [<type>|clear]
      Set, show, or clear the active context (type).
      Without arguments, opens fzf to pick a type interactively.
      Current context is used as default type for other commands.

  mj add [<type>] <alias>
      Save the last terminal command under <alias>.
      Uses current context if <type> is omitted.

  mj add-cmd <type> <alias> "<command>" [--i <param>] [--d "<description>"]
      Manually add a command. Use --i to define an input placeholder
      (<param> in the command string) and --d to attach a description.

  mj use [<type>] [<alias>] [param=value|value]
      Execute a stored command. Without <alias>, opens fzf to pick one.
      If the command has an input parameter, pass a value as the third arg.

  mj <alias> [args...]
      Shorthand for 'mj use' using the current context.

  mj list [<type> [--c]]
      Without <type>, lists all available types.
      With <type>, lists aliases (and descriptions). Add --c to show full commands.

  mj describe <type> <alias>
      Show the alias, command, and description for a stored entry.

  mj remove <type> <alias>
      Remove a stored command.

EXAMPLES
  mj ctx k8s                          # set context to k8s
  mj add rollout                      # save last command as 'rollout' in k8s
  mj rollout                          # run it (context shorthand)
  mj add-cmd docker prune "docker system prune -af" --d "clean up docker"
  mj use docker prune                 # run the docker prune command
  mj list docker --c                  # show docker commands with full command text
HELP
    return 0
  fi

  # If not a valid subcommand and context is set, treat as alias in context
  if [ -n "$cmd" ] && [ "$cmd" != "use" ] && [ "$cmd" != "add" ] && [ "$cmd" != "add-cmd" ] && [ "$cmd" != "list" ] && [ "$cmd" != "remove" ] && [ "$cmd" != "describe" ] && [ "$cmd" != "ctx" ]; then
    # Check if it's an alias in current context
    local ctx
    ctx="$(_mj_get_context)"
    if [ -n "$ctx" ]; then
      # Treat as: mj use <context> <alias> [args...]
      local alias_name="$cmd"
      cmd="use"
      set -- "$ctx" "$alias_name" "$@"
    fi
  fi

  case "$cmd" in
    add)
      local type=""
      local mj_alias=""
      if [ $# -lt 1 ]; then
        echo "usage: mj add [<type>] <alias>" >&2
        return 2
      elif [ $# -eq 1 ]; then
        # Use context if available
        type="$(_mj_get_context)"
        if [ -z "$type" ]; then
          echo "usage: mj add <type> <alias> (or set context with 'mj ctx <type>')" >&2
          return 2
        fi
        mj_alias="$1"
      else
        type="$1"
        mj_alias="$2"
      fi
      mkdir -p "$_mj_cmd_dir"
      # Capture the most recent non-mj, non-"exec zsh" command from recent history
      local prev
      prev="$(fc -ln -30 | awk 'BEGIN{IGNORECASE=1} !/^[[:space:]]*mj([[:space:]]|$)/ && !/^[[:space:]]*exec[[:space:]]+zsh([[:space:]]|$)/ && NF{last=$0} END{print last}')"
      prev="${prev##\ }"
      if [ -z "$prev" ]; then
        echo "no previous command found" >&2
        return 1
      fi
      local file="$_mj_cmd_dir/${type}.txt"
      if [ -f "$file" ] && awk -F'\t' -v a="$mj_alias" '$1==a{f=1} END{exit !f}' "$file"; then
        echo "alias already exists in ${type}: $mj_alias (remove it first)" >&2
        return 1
      fi
      printf '%s\t%s\n' "$mj_alias" "$prev" >> "$file"
      echo "added [$mj_alias] to ${type}: $prev"
      ;;
    add-cmd)
      if [ $# -lt 3 ]; then
        echo "usage: mj add-cmd <type> <alias> \"<command>\" [--i <param_name>] [--d \"<description>\"]" >&2
        return 2
      fi
      local type="$1"
      local mj_alias="$2"
      local cmd="$3"
      shift 3 || true
      local input_param=""
      local desc=""
      while [ $# -gt 0 ]; do
        case "$1" in
          --i)
            shift; input_param="${1:-}"; [ $# -gt 0 ] && shift ;;
          --d)
            shift; desc="${1:-}"; [ $# -gt 0 ] && shift ;;
          *)
            shift ;;
        esac
      done
      mkdir -p "$_mj_cmd_dir"
      local file="$_mj_cmd_dir/${type}.txt"
      local flags_suffix=""
      if [ -n "$input_param" ]; then flags_suffix="  ##i:$input_param"; fi
      if [ -n "$desc" ]; then
        printf '%s\t%s  # %s%s\n' "$mj_alias" "$cmd" "$desc" "$flags_suffix" >> "$file"
        echo "added [$mj_alias] to ${type}: $cmd  # $desc"
      else
        printf '%s\t%s%s\n' "$mj_alias" "$cmd" "$flags_suffix" >> "$file"
        echo "added [$mj_alias] to ${type}: $cmd"
      fi
      ;;
    list)
      if [ $# -lt 1 ]; then
        # Always show all types when no type specified
        echo "available types:" >&2
        command ls -1 "$_mj_cmd_dir" 2>/dev/null | sed 's/\.txt$//' >&2 || true
        return 0
      fi
      local type="$1"
      local show_cmd=false
      if [ "$2" = "--c" ]; then
        show_cmd=true
      fi
      local file="$_mj_cmd_dir/${type}.txt"
      if [ ! -f "$file" ]; then
        echo "no entries for type: $type" >&2
        return 1
      fi
      if [ "$show_cmd" = true ]; then
        # Show full format: alias<TAB>command  # description
        nl -ba "$file"
      else
        # Show only alias and description
        local line_num=1
        while IFS= read -r line; do
          # Parse: alias<TAB>command  # description or alias<TAB>command
          local alias_part="${line%%$'\t'*}"
          local rest="${line#*$'\t'}"
          if [[ "$rest" = *"  # "* ]]; then
            local cmd_part="${rest%%  # *}"
            local desc_part="${rest#*  # }"
            desc_part="${desc_part%%  ##i:*}"
            printf "%6d  %s  # %s\n" "$line_num" "$alias_part" "$desc_part"
          else
            printf "%6d  %s\n" "$line_num" "$alias_part"
          fi
          ((line_num++))
        done < "$file"
      fi
      ;;
    use)
      local type=""
      local mj_alias=""
      local input_value=""
      if [ $# -lt 1 ]; then
        # No args: interactive selection if context is set
        type="$(_mj_get_context)"
        if [ -z "$type" ]; then
          echo "usage: mj use [<type>] <alias> [param_name=value|value]" >&2
          return 2
        fi
        # Interactive alias selection
        local file="$_mj_cmd_dir/${type}.txt"
        if [ ! -f "$file" ]; then
          echo "no entries for type: $type" >&2
          return 1
        fi
        if command -v fzf >/dev/null 2>&1; then
          # Format: alias  # description for display
          local aliases_with_desc
          aliases_with_desc=$(while IFS= read -r line; do
            local alias_part="${line%%$'\t'*}"
            local rest="${line#*$'\t'}"
            if [[ "$rest" = *"  # "* ]]; then
              local desc_part="${rest#*  # }"
              desc_part="${desc_part%%  ##i:*}"
              printf '%s  # %s\n' "$alias_part" "$desc_part"
            else
              printf '%s\n' "$alias_part"
            fi
          done < "$file")
          mj_alias=$(echo "$aliases_with_desc" | fzf --prompt="Select alias in $type: " --height=40% --reverse | awk '{print $1}')
          if [ -z "$mj_alias" ]; then
            return 1
          fi
        else
          echo "usage: mj use <alias> (fzf not available for interactive selection)" >&2
          return 2
        fi
      elif [ $# -eq 1 ]; then
        # One arg: could be type or alias
        # Check if it's a type (has entries) or use as alias with context
        local test_file="$_mj_cmd_dir/$1.txt"
        if [ -f "$test_file" ]; then
          # It's a type, show interactive selection
          type="$1"
          local file="$_mj_cmd_dir/${type}.txt"
          if command -v fzf >/dev/null 2>&1; then
            local aliases_with_desc
            aliases_with_desc=$(while IFS= read -r line; do
              local alias_part="${line%%$'\t'*}"
              local rest="${line#*$'\t'}"
              if [[ "$rest" = *"  # "* ]]; then
                local desc_part="${rest#*  # }"
                desc_part="${desc_part%%  ##i:*}"
                printf '%s  # %s\n' "$alias_part" "$desc_part"
              else
                printf '%s\n' "$alias_part"
              fi
            done < "$file")
            mj_alias=$(echo "$aliases_with_desc" | fzf --prompt="Select alias in $type: " --height=40% --reverse | awk '{print $1}')
            if [ -z "$mj_alias" ]; then
              return 1
            fi
          else
            echo "usage: mj use <type> <alias> (fzf not available for interactive selection)" >&2
            return 2
          fi
        else
          # Use as alias with context
          type="$(_mj_get_context)"
          if [ -z "$type" ]; then
            echo "usage: mj use <type> <alias> [param_name=value|value] (or set context with 'mj ctx <type>')" >&2
            return 2
          fi
          mj_alias="$1"
        fi
      else
        type="$1"
        mj_alias="$2"
        input_value="${3:-}"
      fi
      local file="$_mj_cmd_dir/${type}.txt"
      if [ ! -f "$file" ]; then
        echo "no entries for type: $type" >&2
        return 1
      fi
      # Find line starting with alias<TAB>
      local line
      line="$(awk -F'\t' -v a="$mj_alias" '$1==a{print; exit}' "$file")"
      if [ -z "$line" ]; then
        echo "alias not found: $mj_alias" >&2
        return 1
      fi
      # Strip leading "alias<TAB>", then drop trailing  "  # desc" if present
      cmd="${line#*$'\t'}"
      # Detect and extract input parameter name from flags token
      local input_param=""
      local param_value=""
      if [[ "$cmd" = *"  ##i:"* ]]; then
        input_param="${cmd##*  ##i:}"
        input_param="${input_param%%  # *}"
        input_param="${input_param%% *}"
        cmd="${cmd%  ##i:*}"
      fi
      cmd="${cmd%%  # *}"
      
      # Parse input value: either "param_name=value" or just "value"
      if [ -n "$input_value" ]; then
        if [[ "$input_value" = *"="* ]]; then
          # Format: param_name=value
          local provided_param="${input_value%%=*}"
          param_value="${input_value#*=}"
          if [ -n "$input_param" ] && [ "$provided_param" != "$input_param" ]; then
            echo "parameter name mismatch: expected '$input_param', got '$provided_param'" >&2
            return 2
          fi
        else
          # Format: just value (use stored param name)
          param_value="$input_value"
        fi
      fi
      
      if [ -n "$input_param" ]; then
        if [ -z "$param_value" ]; then
          echo "this alias requires an input value for parameter: $input_param" >&2
          return 2
        fi
        # Replace <param_name> in the command with the value
        local placeholder="<$input_param>"
        cmd="${cmd//$placeholder/$param_value}"
      fi
      echo "$cmd"
      eval "$cmd"
      ;;
    remove)
      if [ $# -lt 2 ]; then
        echo "usage: mj remove <type> <alias>" >&2
        return 2
      fi
      local type="$1"
      local mj_alias="$2"
      local file="$_mj_cmd_dir/${type}.txt"
      if [ ! -f "$file" ]; then
        echo "no entries for type: $type" >&2
        return 1
      fi
      local tmp
      tmp="$(mktemp)"
      # Keep lines that do NOT start with "alias<TAB>"
      awk -F'\t' -v a="$mj_alias" '$1!=a' "$file" > "$tmp" || true
      if cmp -s "$file" "$tmp"; then
        rm -f "$tmp"
        echo "no entry found for alias: $mj_alias" >&2
        return 1
      fi
      cat "$tmp" > "$file" && rm -f "$tmp"
      echo "removed alias [$mj_alias] from ${type}"
      ;;
    describe)
      if [ $# -lt 2 ]; then
        echo "usage: mj describe <type> <alias>" >&2
        return 2
      fi
      local type="$1"
      local mj_alias="$2"
      local file="$_mj_cmd_dir/${type}.txt"
      if [ ! -f "$file" ]; then
        echo "no entries for type: $type" >&2
        return 1
      fi
      # Find line starting with alias<TAB>
      local line
      line="$(awk -F'\t' -v a="$mj_alias" '$1==a{print; exit}' "$file")"
      if [ -z "$line" ]; then
        echo "alias not found: $mj_alias" >&2
        return 1
      fi
      # Parse: alias<TAB>command  # description or alias<TAB>command
      local alias_part="${line%%$'\t'*}"
      local rest="${line#*$'\t'}"
      if [[ "$rest" = *"  # "* ]]; then
        local cmd_part="${rest%%  # *}"
        local desc_part="${rest#*  # }"
        desc_part="${desc_part%%  ##i:*}"
        echo "alias: $alias_part"
        echo "command: $cmd_part"
        echo "description: $desc_part"
      else
        echo "alias: $alias_part"
        echo "command: $rest"
      fi
      ;;
    ctx)
      if [ $# -lt 1 ]; then
        # Interactive selection with fzf if available
        if command -v fzf >/dev/null 2>&1; then
          local types
          types=($(command ls -1 "$_mj_cmd_dir" 2>/dev/null | sed 's/\.txt$//' | grep -v '^\.' 2>/dev/null || true))
          if [ ${#types[@]} -eq 0 ]; then
            echo "no types available" >&2
            return 1
          fi
          # Get current context for highlighting
          local current_ctx
          current_ctx="$(_mj_get_context)"
          # Format types list with green highlight for current context
          local selected
          selected=$({
            for t in "${types[@]}"; do
              if [ "$t" = "$current_ctx" ]; then
                printf '\033[32m%s\033[0m\n' "$t"  # Green
              else
                printf '%s\n' "$t"
              fi
            done
            printf '%s\n' "clear"
          } | fzf --prompt="Select context: " --height=40% --reverse --ansi)
          if [ -z "$selected" ]; then
            return 1
          fi
          # Strip ANSI codes from selection
          selected=$(echo "$selected" | sed 's/\x1b\[[0-9;]*m//g')
          if [ "$selected" = "clear" ]; then
            rm -f "$_mj_ctx_file"
            echo "context cleared"
          else
            _mj_set_context "$selected"
            echo "context set to: $selected"
          fi
        else
          # Fallback: show current context
          local ctx
          ctx="$(_mj_get_context)"
          if [ -n "$ctx" ]; then
            echo "current context: $ctx"
          else
            echo "no context set"
          fi
        fi
        return 0
      fi
      local type="$1"
      # Verify type exists
      local file="$_mj_cmd_dir/${type}.txt"
      if [ ! -f "$file" ] && [ "$type" != "clear" ]; then
        echo "warning: type '$type' has no entries yet" >&2
      fi
      if [ "$type" = "clear" ]; then
        rm -f "$_mj_ctx_file"
        echo "context cleared"
      else
        _mj_set_context "$type"
        echo "context set to: $type"
      fi
      ;;
    *)
      if [ -z "$cmd" ]; then
        _mj_tui_loop
      else
        echo "unknown command: $cmd" >&2
        echo "usage: mj {add|add-cmd|list|use|remove|describe|ctx|<alias>}" >&2
        return 2
      fi
      ;;
  esac
}

