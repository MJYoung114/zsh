# Shell functions

# Show tip when checking Node.js version via node --version or -v
if command -v node >/dev/null 2>&1; then
node() {
    if [ $# -eq 1 ] && { [ "$1" = "--version" ] || [ "$1" = "-v" ]; }; then
        command node --version
        echo "fnm use <version> to change version"
    else
        command node "$@"
    fi
}
fi

# MJ commands store (per-type lists under ~/.config/mj-commands)
_mj_cmd_dir="${XDG_CONFIG_HOME:-$HOME/.config}/mj-commands"

mj() {
  local cmd="${1:-}"
  shift || true

  case "$cmd" in
    add)
      if [ $# -lt 2 ]; then
        echo "usage: mj add <type> <alias> [--i] [--d \"<description>\"]" >&2
        return 2
      fi
      local type="$1"
      local mj_alias="$2"
      shift 2 || true
      local input_flag=false
      local desc=""
      while [ $# -gt 0 ]; do
        case "$1" in
          --i)
            input_flag=true; shift ;;
          --d)
            shift; desc="${1:-}"; [ $# -gt 0 ] && shift ;;
          *)
            shift ;;
        esac
      done
      mkdir -p "$_mj_cmd_dir"
      # Capture the most recent non-mj, non-"exec zsh" command from recent history
      local prev
      prev="$(fc -ln -30 | awk 'BEGIN{IGNORECASE=1} !/^[[:space:]]*mj([[:space:]]|$)/ && !/^[[:space:]]*exec[[:space:]]+zsh([[:space:]]|$)/ && NF{last=$0} END{print last}')"
      prev="${prev##\ }"
      if [ -z "$prev" ]; then
        echo "no previous command found" >&2
        return 1
      fi
      # Disallow storing mj commands
      case "$prev" in
        mj\ *)
          echo "refusing to add an mj command" >&2
          return 1
          ;;
      esac
      local file="$_mj_cmd_dir/${type}.txt"
      local flags_suffix=""
      if [ "$input_flag" = true ]; then flags_suffix="  ##i"; fi
      if [ -n "$desc" ]; then
        printf '%s\t%s  # %s%s\n' "$mj_alias" "$prev" "$desc" "$flags_suffix" >> "$file"
        echo "added [$mj_alias] to ${type}: $prev  # $desc"
      else
        printf '%s\t%s%s\n' "$mj_alias" "$prev" "$flags_suffix" >> "$file"
        echo "added [$mj_alias] to ${type}: $prev"
      fi
      ;;
    list)
      if [ $# -lt 1 ]; then
        echo "available types:" >&2
        command ls -1 "$_mj_cmd_dir" 2>/dev/null | sed 's/\.txt$//' >&2 || true
        return 0
      fi
      local type="$1"
      local show_cmd=false
      if [ "$2" = "--c" ]; then
        show_cmd=true
      fi
      local file="$_mj_cmd_dir/${type}.txt"
      if [ ! -f "$file" ]; then
        echo "no entries for type: $type" >&2
        return 1
      fi
      if [ "$show_cmd" = true ]; then
        # Show full format: alias<TAB>command  # description
        nl -ba "$file"
      else
        # Show only alias and description
        local line_num=1
        while IFS= read -r line; do
          # Parse: alias<TAB>command  # description or alias<TAB>command
          local alias_part="${line%%$'\t'*}"
          local rest="${line#*$'\t'}"
          if [[ "$rest" = *"  # "* ]]; then
            local cmd_part="${rest%%  # *}"
            local desc_part="${rest#*  # }"
            printf "%6d  %s  # %s\n" "$line_num" "$alias_part" "$desc_part"
          else
            printf "%6d  %s\n" "$line_num" "$alias_part"
          fi
          ((line_num++))
        done < "$file"
      fi
      ;;
    use)
      if [ $# -lt 2 ]; then
        echo "usage: mj use <type> <alias> [input]" >&2
        return 2
      fi
      local type="$1"
      local mj_alias="$2"
      local input_value="${3:-}"
      local file="$_mj_cmd_dir/${type}.txt"
      if [ ! -f "$file" ]; then
        echo "no entries for type: $type" >&2
        return 1
      fi
      # Find line starting with alias<TAB>
      local line
      line="$(grep -E "^$(printf '%s' "$mj_alias" | sed 's/[].[^$*\\|?+(){}]/\\&/g')\t" "$file" | head -n1)"
      if [ -z "$line" ]; then
        echo "alias not found: $mj_alias" >&2
        return 1
      fi
      # Strip leading "alias<TAB>", then drop trailing  "  # desc" if present
      local cmd
      cmd="${line#*$'\t'}"
      # Detect and remove flags token
      local has_input=false
      if [[ "$cmd" = *"  ##i"* ]]; then
        has_input=true
        cmd="${cmd%  ##i}"
      fi
      cmd="${cmd%%  # *}"
      if [ "$has_input" = true ]; then
        if [ -z "$input_value" ]; then
          echo "this alias requires an input argument" >&2
          return 2
        fi
        cmd="$cmd $input_value"
      fi
      echo "$cmd"
      eval "$cmd"
      ;;
    remove)
      if [ $# -lt 2 ]; then
        echo "usage: mj remove <type> <alias>" >&2
        return 2
      fi
      local type="$1"
      local mj_alias="$2"
      local file="$_mj_cmd_dir/${type}.txt"
      if [ ! -f "$file" ]; then
        echo "no entries for type: $type" >&2
        return 1
      fi
      local tmp
      tmp="$(mktemp)"
      # Keep lines that do NOT start with "alias<TAB>"
      grep -v -E "^$(printf '%s' "$mj_alias" | sed 's/[].[^$*\\|?+(){}]/\\&/g')\t" "$file" > "$tmp" || true
      if cmp -s "$file" "$tmp"; then
        rm -f "$tmp"
        echo "no entry found for alias: $mj_alias" >&2
        return 1
      fi
      mv "$tmp" "$file"
      echo "removed alias [$mj_alias] from ${type}"
      ;;
    describe)
      if [ $# -lt 2 ]; then
        echo "usage: mj describe <type> <alias>" >&2
        return 2
      fi
      local type="$1"
      local mj_alias="$2"
      local file="$_mj_cmd_dir/${type}.txt"
      if [ ! -f "$file" ]; then
        echo "no entries for type: $type" >&2
        return 1
      fi
      # Find line starting with alias<TAB>
      local line
      line="$(grep -E "^$(printf '%s' "$mj_alias" | sed 's/[].[^$*\\|?+(){}]/\\&/g')\t" "$file" | head -n1)"
      if [ -z "$line" ]; then
        echo "alias not found: $mj_alias" >&2
        return 1
      fi
      # Parse: alias<TAB>command  # description or alias<TAB>command
      local alias_part="${line%%$'\t'*}"
      local rest="${line#*$'\t'}"
      if [[ "$rest" = *"  # "* ]]; then
        local cmd_part="${rest%%  # *}"
        local desc_part="${rest#*  # }"
        echo "alias: $alias_part"
        echo "command: $cmd_part"
        echo "description: $desc_part"
      else
        echo "alias: $alias_part"
        echo "command: $rest"
      fi
      ;;
    *)
      echo "usage: mj {add|list|use|remove|describe}" >&2
      echo "  mj add <type> <alias> [--i] [--d \"<description>\"]" >&2
      echo "  mj list [<type> [--c]]" >&2
      echo "  mj use <type> <alias> [input]" >&2
      echo "  mj remove <type> <alias>" >&2
      echo "  mj describe <type> <alias>" >&2
      return 2
      ;;
  esac
}

